<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <title>Welcome to the Civilization — Your Membership Is Approved</title>
    <!--[if mso]>
    <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
    <![endif]-->
    <style>
        @media only screen and (max-width: 620px) {
            .email-container { width: 100% !important; }
            .px { padding-left: 24px !important; padding-right: 24px !important; }
            .passport { font-size: 24px !important; letter-spacing: 4px !important; }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#F5F5F0; font-family:Georgia,'Times New Roman',Arial,sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">Your Vhennus membership has been approved. Welcome to the civilization.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F5F0; margin:0; padding:0;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="email-container" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #E8E2D5;">
                    <!-- Top gold rule -->
                    <tr><td style="height:4px; line-height:4px; background-color:#C9A86A; font-size:0;">&nbsp;</td></tr>
                    <!-- Header -->
                    <tr>
                        <td align="center" style="background-color:#0A1931; padding:36px 32px 28px 32px;">
                            <div style="font-family:Georgia,'Times New Roman',serif; font-size:30px; font-weight:bold; color:#F5F5F0; letter-spacing:3px; text-transform:uppercase;">Vhennus</div>
                            <div style="width:56px; height:2px; background-color:#C9A86A; margin:14px auto 12px auto; line-height:2px; font-size:0;">&nbsp;</div>
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; letter-spacing:2.5px; text-transform:uppercase; color:#C9A86A;">The New Digital Nation</div>
                        </td>
                    </tr>
                    <!-- Body -->
                    <tr>
                        <td class="px" style="padding:40px 44px 12px 44px; background-color:#ffffff;">
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:12px; letter-spacing:2px; text-transform:uppercase; color:#CC5A2A; font-weight:bold; text-align:center;">Membership Approved</div>
                            <h1 style="font-family:Georgia,'Times New Roman',serif; font-size:26px; line-height:34px; color:#0A1931; text-align:center; margin:12px 0 12px 0; font-weight:bold;">Welcome to<br>the civilization.</h1>
                            <p style="font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px; color:#3D4451; text-align:center; margin:0 0 28px 0;">Your membership application has been reviewed and approved. You are now a citizen of Vhennus.</p>
                            <!-- Passport card -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="background-color:#0A1931; border:1px solid #C9A86A; border-radius:10px; padding:28px 20px;">
                                        <div style="font-family:Arial,Helvetica,sans-serif; font-size:11px; letter-spacing:2px; text-transform:uppercase; color:#C9A86A; margin-bottom:10px;">Your digital passport ID</div>
                                        <div class="passport" style="font-family:'Courier New',Courier,monospace; font-size:30px; font-weight:bold; letter-spacing:6px; color:#F5F5F0;">{{user_name}}</div>
                                        <div style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#9AA3B2; margin-top:10px;">Keep it safe — it is your identity in the civilization</div>
                                    </td>
                                </tr>
                            </table>
                            <p style="font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px; color:#3D4451; text-align:left; margin:28px 0 0 0;">Your username is your <strong>digital passport ID</strong>. Use it to access everything that belongs to the community:</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;">
                                <tr>
                                    <td style="font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:28px; color:#3D4451; padding-left:8px;">
                                        &#9679; &nbsp;Wallets<br>
                                        &#9679; &nbsp;Hotels<br>
                                        &#9679; &nbsp;Assets<br>
                                        &#9679; &nbsp;Services<br>
                                        &#9679; &nbsp;Marketplaces
                                    </td>
                                </tr>
                            </table>
                            <p style="font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:24px; color:#3D4451; text-align:left; margin:20px 0 8px 0;">One People, One Vision — we are glad to build with you.</p>
                        </td>
                    </tr>
                    <!-- Signature -->
                    <tr>
                        <td class="px" style="padding:12px 44px 36px 44px; background-color:#ffffff;">
                            <div style="border-top:1px solid #E8E2D5; padding-top:24px; text-align:center;">
                                <p style="font-family:Georgia,'Times New Roman',serif; font-style:italic; font-size:15px; color:#0A1931; margin:0;">Building a new civilization on love, light &amp; life.</p>
                                <p style="font-family:Arial,Helvetica,sans-serif; font-size:13px; color:#3D4451; margin:8px 0 0 0;"><strong>The Vhennus Team</strong></p>
                            </div>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background-color:#0A1931; padding:28px 32px;">
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#C9A86A; margin-bottom:8px;">&copy; 2026 Vhennus. All rights reserved.</div>
                            <div style="font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#9AA3B2; line-height:20px;">No longer want to receive these emails? <a href="#" style="color:#C9A86A; text-decoration:underline;">Unsubscribe</a></div>
                        </td>
                    </tr>
                    <tr><td style="height:4px; line-height:4px; background-color:#C9A86A; font-size:0;">&nbsp;</td></tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
